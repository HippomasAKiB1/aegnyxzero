# AegnyxZero Backend Environment Configuration

# Server Mode (true = offline zero-API-key demo; false = live AI gateway)
DEMO_MODE=false
USE_V2_PIPELINE=true
DATASET_VERSION=v1
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (comma-separated list for production e.g. Vercel)
# Local: http://localhost:5173
# Production: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# Optional Free-Tier LLM Provider API Keys (leave blank for demo fallback)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings & Orchestration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDERS=openrouter,gemini,groq,ollama
